# Operational env for docker-compose.yml.
#
# Copy to .env on each host and fill in real values. The real .env is
# host-only state and gitignored — never commit it.
#
# This file is the COMPLETE inventory of env vars the stack reads from .env.
# Vars that are hardcoded as defaults in docker-compose.yml (e.g.
# MAX_PHOTOS_PER_SCAN, PRESIGNED_URL_EXPIRY_SECONDS) are intentionally
# absent. To make one of those host-configurable, switch the compose entry
# to ${VAR_NAME} substitution and add it here in the same PR.

# Postgres + MinIO share a single credential pair in v1 (see CLAUDE.md).
# Rotate them together; the api/worker services authenticate against
# both and assume they match.
POSTGRES_PASSWORD=<set-on-host>
MINIO_ROOT_USER=<set-on-host>
MINIO_ROOT_PASSWORD=<set-on-host>

# Tailscale-issued hostname for the Mini, used by the api/worker services
# to construct presigned MinIO URLs reachable from clients on the tailnet.
TAILSCALE_HOST=<your-machine>.<your-tailnet>.ts.net

# Comma-separated CORS origins for the FastAPI service. Include the PWA
# dev origin (Vite default localhost:5173) and the production origin
# (whatever nginx fronts on the tailnet).
CORS_ORIGINS=http://localhost:5173,https://<your-machine>.<your-tailnet>.ts.net
